# nuage-autopilot の環境変数定義テンプレート。
#
# このファイル自体はテンプレートであり、実際のシークレットや値を書き込んでコミットしてはならない。
# 環境変数として本プロセスへ渡すか、systemd の EnvironmentFile などで読み込ませて利用する。
#
# KEY=VALUE 書式:
#   - KEY=VALUE を 1 行に 1 つ書く
#   - # で始まる行はコメントとして無視される

# --- GitHub トークン --------------------------------------------------------
# gh CLI, git push, および GitHub API 呼び出しに使用する。
# 必要なスコープ: repo (Issue/PR/ラベルの読み書き), workflows (ワークフロー変更時)
GH_TOKEN=

# --- Git のコミット名義 -------------------------------------------------------
# autopilot が作成するコミットの名義。
GIT_AUTHOR_NAME=nuage-autopilot
GIT_AUTHOR_EMAIL=autopilot@users.noreply.github.com

# --- 対象アイテム制限 (オプション) --------------------------------------------
# 許可する Issue/PR 作成者のユーザー名をカンマ区切りで指定する（空の場合は全ユーザー対象）。
# NUAGE_ALLOWED_AUTHORS=

# --- 状態保存ディレクトリ (オプション) ----------------------------------------
# SQLite データベースや作業用クローンを保存するパス（既定: ./state）。
# NUAGE_STATE_DIR=./state
