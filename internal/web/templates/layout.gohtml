{{define "layout"}}
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="30">
  <title>nuage-autopilot ダッシュボード</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">nuage-autopilot</a>
    <span class="readonly-badge">閲覧専用</span>
  </header>
  <main>
    {{template "content" .}}
  </main>
  <footer>
    <p>30 秒ごとに自動更新。この画面は SQLite の内容を読み取り専用で表示するだけであり、ここから操作は行えない。</p>
  </footer>
</body>
</html>
{{end}}
