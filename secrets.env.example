# nuage-autopilot のシークレット定義のテンプレート。
#
# このファイル自体はテンプレートであり、実際の値を書き込んでコミットしてはならない。
# autopilot-server 上の /var/lib/nuage-autopilot/secrets.env へ手作業で配置する。
# SOPS では配布しない (流出時の影響が大きいため、意図的に Git 管理外としている)。
#
# claude / agy の認証情報はここに書かない。各 CLI の TUI でサインインし、
# サービス実行ユーザー (既定: nixos) の HOME に保存されたものを利用する。
#
# 配置手順:
#   scp autopilot/secrets.env.example nixos@192.168.5.241:/tmp/secrets.env
#   ssh nixos@192.168.5.241
#   sudo install -o nixos -g users -m 0600 -D /tmp/secrets.env /var/lib/nuage-autopilot/secrets.env
#   sudo $EDITOR /var/lib/nuage-autopilot/secrets.env   # 実際の値を記入する
#   rm /tmp/secrets.env
#
# 書式は systemd の EnvironmentFile であり、シェルスクリプトではない。以下に注意する。
#   - `export` は書かない (そのまま変数名の一部として解釈される)
#   - `KEY=VALUE` を 1 行に 1 つ書く
#   - `#` で始まる行はコメントとして無視される
#   - `$VAR` による変数展開やコマンド置換は行われない
#   - 値に空白を含める場合のみ引用符で囲む

# --- GitHub -----------------------------------------------------------------
# gh CLI と Go 実装の双方が参照する。git push の認証にも用いる。
# 未設定の場合、autopilot は警告ログを出して何もせず正常終了する。
#
# 必要なスコープ: repo (Issue/PR/ラベルの読み書き)
#                 workflow (.github/workflows を変更する場合のみ)
#                 read:org (組織リポジトリを対象にする場合のみ)
# Fine-grained PAT を使う場合は Contents / Issues / Pull requests / Workflows を Read and write にする。
GH_TOKEN=

# --- Git のコミット名義 -------------------------------------------------------
# autopilot が作成するコミットの名義。GitHub 上で人間の変更と区別できるようにする。
# committer は author と同じ値を使うため、ここでは author のみを定義する。
# 実際に commit を行う Phase 3 で必須になる。
GIT_AUTHOR_NAME=nuage-autopilot
GIT_AUTHOR_EMAIL=autopilot@users.noreply.github.com
